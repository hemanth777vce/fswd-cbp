# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Option 1 (Local): mongodb://localhost:27017/devpulse
# Option 2 (Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/devpulse?retryWrites=true&w=majority
# Option 3 (In-Memory / Auto-Fallback): Leave blank or use 'memory' to use auto-provisioned in-memory MongoDB
MONGO_URI=mongodb://localhost:27017/devpulse

# JWT Secret for Token Signing
JWT_SECRET=devpulse_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
